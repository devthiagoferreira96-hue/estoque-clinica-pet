# ===== Banco (Supabase > Project Settings > Database > Connection string > URI) =====
# Use a conexão "Session pooler" (porta 5432). Troque [SENHA] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# ===== Supabase Storage (fotos dos produtos) - Project Settings > API =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key
SUPABASE_BUCKET=produtos

# ===== Segurança =====
JWT_SECRET=troque-por-uma-frase-longa-e-secreta
JWT_EXPIRES_IN=12h

# Primeiro acesso: este administrador é criado automaticamente se não existir nenhum usuário
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=trocar123

# Fuso horário usado nos relatórios
TZ_CLINICA=America/Sao_Paulo

PORT=3334
FRONTEND_URL=http://localhost:3001
